{
  "name": "streak-maintainer",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:android:apk": "eas build -p android --profile preview",
    "build:android:aab": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "build:dev": "eas build --profile development --platform all",
    "submit:android": "eas submit -p android --profile production",
    "submit:ios": "eas submit -p ios --profile production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-network": "~7.0.0",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.3.3"
  }
}